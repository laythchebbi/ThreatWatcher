    "dotenv": "16.4.5",
    "express": "4.22.3",
    "helmet": "8.0.0",
    "jose": "5.9.6",
    "mongoose": "8.24.4",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "11.3.0",
