# Required
MONGODB_URI=mongodb://localhost:27017/threatwatcher

# WorkOS (User Management / AuthKit)
# Get from https://dashboard.workos.com → API Keys & Configuration
WORKOS_API_KEY=sk_test_change_me
WORKOS_CLIENT_ID=client_change_me
# Single-tenant: the one org all users belong to (start with the default org)
WORKOS_ORGANIZATION_ID=org_change_me

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ML bridge
PYTHON_BIN=python3
ML_URL_MODEL=ml/models/url_classifier.pkl

# Optional: file-target for pino (mkdir is automatic)
# LOG_FILE=/var/log/threat-watcher/backend.log
