# Normalize line endings to LF in the repo (avoids CRLF churn across OSes).
* text=auto eol=lf

# Treat known binaries as binary (no EOL conversion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.pkl binary
*.joblib binary
*.onnx binary
