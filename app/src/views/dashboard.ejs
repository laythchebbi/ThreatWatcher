<div class="tw-page-head" style="margin-bottom:18px">
  <div class="tw-eyebrow">Watch · Dashboard</div>
  <h1>What changed</h1>
</div>

<div class="tw-stat-grid">
  <div class="tw-stat-card"><div class="tw-stat-label">Domains watched</div><div class="tw-stat-value tw-num"><%= stats.domains %></div></div>
  <div class="tw-stat-card"><div class="tw-stat-label">Open sightings</div><div class="tw-stat-value tw-num" style="color:var(--tw-warn)"><%= stats.openSightings %></div></div>
  <div class="tw-stat-card"><div class="tw-stat-label">Events, last 24 h</div><div class="tw-stat-value tw-num" style="color:var(--tw-critical)"><%= stats.recentEvents %></div></div>
</div>

<div class="tw-dash-row">
  <div class="tw-panel">
    <div class="tw-panel-head"><div><div class="tw-eyebrow">Events</div><h2>Newest first</h2></div></div>
    <div class="tw-panel-body">
      <% if (events.length === 0) { %>
        <div class="tw-empty">No events yet. Add a domain and the first watch runs within a minute.</div>
      <% } else { %>
        <table class="tw-table-min">
          <thead><tr><th></th><th>When</th><th>Domain</th><th>Event</th><th>Lookalike</th></tr></thead>
          <tbody>
          <% events.forEach(function (e) { %>
            <tr class="sev-<%= e.severity %>">
              <td class="tw-sev-cell"><span class="tw-sev tw-sev-<%= e.severity %>" title="<%= e.severity %>"></span></td>
              <td class="tw-mono tw-fg-2"><%= new Date(e.at).toISOString().slice(0, 16).replace("T", " ") %></td>
              <td class="tw-mono"><a href="/domains/<%= e.domainId %>"><%= e.domainName %></a></td>
              <td class="tw-mono"><%= e.kind %></td>
              <td class="tw-mono"><%= e.payload && e.payload.lookalike ? e.payload.lookalike : "" %></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
  <div class="tw-panel">
    <div class="tw-panel-head"><div><div class="tw-eyebrow">Watch</div><h2>Domains</h2></div><a class="tw-btn tw-btn-ghost tw-btn-sm" href="/domains">Manage</a></div>
    <div class="tw-monitor-list">
      <% domains.forEach(function (d) { %>
        <div class="tw-monitor-item"><div><div class="domain"><a href="/domains/<%= d._id %>"><%= d.name %></a></div><div class="sub">next watch <%= d.nextWatchAt ? new Date(d.nextWatchAt).toISOString().slice(0, 16).replace("T", " ") : "—" %></div></div></div>
      <% }); %>
      <% if (domains.length === 0) { %><div class="tw-monitor-item tw-empty">No domains yet. <a href="/domains">Add one</a></div><% } %>
    </div>
  </div>
</div>
