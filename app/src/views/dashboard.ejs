<div class="tw-page-head">
  <div>
    <h1>What changed</h1>
    <p class="tw-lede">
    <% if (stats.domains === 0) { %>
      Nothing is watched yet. <a href="/domains">Add a domain</a> and the first watch runs within a minute.
    <% } else if (worst) { %>
      <% var parts = []; if (counts.critical) parts.push(counts.critical + " critical"); if (counts.high) parts.push(counts.high + " high"); %>
      <strong><%= parts.join(" and ") %></strong> lookalike<%= (counts.critical || 0) + (counts.high || 0) === 1 ? " is" : "s are" %> open.
      Worst: <a class="tw-mono" href="/domains/<%= worst.domainId %>"><%= worst.lookalike %></a><% if (worstEvent) { %>, <%= eventLabel(worstEvent.kind).toLowerCase() %> at <span class="tw-mono"><%= fmtTime(worstEvent.at) %> UTC</span><% } %>.
    <% } else { %>
      Nothing above medium is open across <%= stats.domains %> domain<%= stats.domains === 1 ? "" : "s" %>.<% if (lastWatchedAt) { %> Last watch <span class="tw-mono"><%= fmtTime(lastWatchedAt) %> UTC</span>.<% } %>
    <% } %>
    </p>
  </div>
</div>

<ul class="tw-facts" aria-label="Summary">
  <li><b><%= stats.domains %></b> domains watched</li>
  <li><b><%= stats.openSightings %></b> open sightings</li>
  <li><b><%= stats.openMentions %></b> open leak mentions</li>
  <li><b><%= stats.recentEvents %></b> events in the last 24 h</li>
</ul>

<div class="tw-grid-main">
  <section class="tw-panel" aria-labelledby="events-h">
    <div class="tw-panel-head"><h2 id="events-h">Events</h2><span class="tw-meta">newest first · times in UTC</span></div>
    <div class="tw-panel-body">
      <% if (events.length === 0) { %>
        <div class="tw-empty">No events yet. Each watch cycle adds one event per change it finds.</div>
      <% } else { %>
        <table class="tw-table tw-table-stack">
          <thead><tr><th scope="col">Severity</th><th scope="col">When</th><th scope="col">Domain</th><th scope="col">Event</th><th scope="col">Subject</th></tr></thead>
          <tbody>
          <% events.forEach(function (e) { %>
            <tr>
              <td><span class="tw-sev" data-sev="<%= e.severity %>"><%= sevLabel(e.severity) %></span></td>
              <td class="tw-mono tw-fg-2 tw-nowrap"><%= fmtTime(e.at) %></td>
              <td class="span"><a class="domain-name" href="/domains/<%= e.domainId %>"><%= e.domainName %></a></td>
              <td class="span"><%= eventLabel(e.kind) %></td>
              <td class="span"><%- include("partials/event-subject", { e: e }) %></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>

  <section class="tw-panel" aria-labelledby="domains-h">
    <div class="tw-panel-head"><h2 id="domains-h">Domains</h2><a class="tw-btn tw-btn-ghost tw-btn-sm" href="/domains">Manage</a></div>
    <ul class="tw-list">
      <% domains.forEach(function (d) { %>
        <li style="grid-template-columns:minmax(0,1fr)">
          <a class="domain-name tw-mono" href="/domains/<%= d._id %>"><%= d.name %></a>
          <span class="tw-meta">next watch <%= fmtTime(d.nextWatchAt) %> UTC</span>
        </li>
      <% }); %>
      <% if (domains.length === 0) { %><li style="display:block" class="tw-empty"><a href="/domains">Add your first domain</a></li><% } %>
    </ul>
  </section>
</div>
