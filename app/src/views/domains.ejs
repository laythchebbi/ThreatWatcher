<div class="tw-page-head">
  <div>
    <h1>Protected domains</h1>
    <p class="tw-lede">Each domain is watched every few hours for new lookalikes, certificates, live pages and leak mentions.</p>
  </div>
  <span class="tw-meta"><%= domains.length %> of <%= limit %> domains</span>
</div>

<% if (notice) { %><div class="tw-banner tw-banner-info" role="status"><%= notice %></div><% } %>

<form class="tw-scan-bar" method="post" action="/domains">
  <label for="add-domain" class="tw-sr-only">Domain to watch</label>
  <input id="add-domain" name="name" placeholder="Add a domain to watch, e.g. acme-corp.com" autocomplete="off" spellcheck="false" required pattern="^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}\.?$" title="A domain name such as acme-corp.com" <%= verified ? "" : "disabled" %>>
  <button class="tw-btn tw-btn-primary" type="submit" <%= verified ? "" : "disabled" %>>Watch</button>
</form>
<% if (!verified) { %><p class="tw-help" style="margin:0 0 16px">Verify your email first. The link is in your inbox.</p><% } %>

<section class="tw-panel" style="margin-top:16px" aria-label="Watched domains">
  <div class="tw-panel-body">
    <table class="tw-table">
      <thead><tr><th scope="col">Domain</th><th scope="col">Open sightings</th><th scope="col" class="tw-hide-sm">Last watched (UTC)</th><th scope="col">Next watch (UTC)</th><th scope="col" class="end"><span class="tw-fg-3">Actions</span></th></tr></thead>
      <tbody>
      <% domains.forEach(function (d) { %>
        <tr>
          <td><a class="domain-name" href="/domains/<%= d._id %>"><%= d.name %></a></td>
          <td class="tw-num"><%= d.openSightings %></td>
          <td class="tw-mono tw-fg-2 tw-nowrap tw-hide-sm"><%= d.lastWatchedAt ? fmtTime(d.lastWatchedAt) : "not yet" %></td>
          <td class="tw-mono tw-fg-2 tw-nowrap"><%= fmtTime(d.nextWatchAt) %></td>
          <td class="end"><form method="post" action="/domains/<%= d._id %>/delete" style="margin:0" onsubmit="return confirm('Stop watching <%= d.name %> and delete its history?')"><button class="tw-btn tw-btn-sm tw-btn-danger" type="submit" aria-label="Remove <%= d.name %>">Remove</button></form></td>
        </tr>
      <% }); %>
      <% if (domains.length === 0) { %><tr class="tw-empty-row"><td colspan="5" class="tw-empty">Nothing watched yet. Add your company's main domain above; the first watch runs within a minute.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
