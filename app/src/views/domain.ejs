<style>
.dom-head { display:flex; justify-content:space-between; align-items:flex-end; gap:14px; margin-bottom:18px; flex-wrap:wrap; }
.dom-tabs { display:flex; gap:0; border-bottom:1px solid var(--tw-line); margin-bottom:0; overflow-x:auto; }
.dom-tab { padding:10px 14px; cursor:pointer; color:var(--tw-fg-2); border-bottom:2px solid transparent; user-select:none; white-space:nowrap; font-size:13px; background:none; border-top:0; border-left:0; border-right:0; font-family:inherit; }
.dom-tab.active { color:var(--tw-fg-0); border-bottom-color:var(--tw-accent); }
.dom-tab .count { margin-left:6px; padding:1px 6px; background:var(--tw-bg-3); border-radius:99px; font-family:var(--tw-font-mono); font-size:10px; }
.dom-grid { display:grid; grid-template-columns: 1fr 340px; gap:14px; }
@media (max-width:1100px) { .dom-grid { grid-template-columns:1fr; } }
.tl { list-style:none; margin:0; padding:0; }
.tl li { display:grid; grid-template-columns:10px 120px 1fr; gap:10px; padding:8px 14px; border-bottom:1px solid var(--tw-line); font-size:12px; align-items:center; }
.tl li:last-child { border-bottom:0; }
.chip { display:inline-block; padding:1px 7px; border-radius:99px; font-family:var(--tw-font-mono); font-size:10px; background:var(--tw-bg-3); color:var(--tw-fg-1); margin-right:4px; }
.chip-warn { background:var(--tw-warn-soft); color:var(--tw-warn); }
.chip-info { background:var(--tw-info-soft); color:var(--tw-info); }
.row-actions { display:flex; gap:4px; justify-content:flex-end; }
</style>

<div class="dom-head">
  <div>
    <div class="tw-eyebrow">Watch · Domain</div>
    <h1 class="tw-mono"><%= domain.name %></h1>
    <div class="tw-fg-2 tw-mono" style="font-size:11px;margin-top:4px">
      last watched <%= domain.lastWatchedAt ? new Date(domain.lastWatchedAt).toISOString().slice(0, 16).replace("T", " ") : "not yet" %> ·
      next <%= domain.nextWatchAt ? new Date(domain.nextWatchAt).toISOString().slice(0, 16).replace("T", " ") : "—" %>
      <% if (domain.watchingSince) { %> · <span style="color:var(--tw-info)">watching now</span><% } %>
    </div>
  </div>
  <form method="post" action="/domains/<%= domain._id %>/scan" style="margin:0"><button class="tw-btn tw-btn-primary" type="submit">Scan now</button></form>
</div>

<div class="tw-panel" style="margin-bottom:14px;padding:12px 16px">
  <div class="tw-eyebrow">Brand terms for leak matching</div>
  <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px">
    <% (domain.terms || []).forEach(function (term) { %>
      <form method="post" action="/domains/<%= domain._id %>/terms/delete" style="margin:0;display:inline-flex;align-items:center;gap:6px" class="chip">
        <span class="tw-mono"><%= term %></span><input type="hidden" name="term" value="<%= term %>"><button class="tw-btn tw-btn-sm tw-btn-ghost" type="submit" aria-label="Remove">×</button>
      </form>
    <% }); %>
    <form method="post" action="/domains/<%= domain._id %>/terms" style="margin:0;display:inline-flex;gap:6px">
      <input class="tw-input tw-mono" name="term" placeholder="e.g. acme bank" minlength="4" maxlength="40" required style="width:200px">
      <button class="tw-btn tw-btn-sm tw-btn-primary" type="submit">Add term</button>
    </form>
  </div>
  <p class="tw-fg-2" style="font-size:11px;margin:8px 0 0">Your domain label is matched automatically. Add brand names people write without the domain, up to five.</p>
</div>

<div class="tw-panel" style="margin-bottom:14px;padding:12px 16px">
  <div class="tw-eyebrow">Have I Been Pwned breaches</div>
  <% if (domain.hibp && domain.hibp.apiKey) { %>
    <div class="tw-mono tw-fg-2" style="font-size:11px;margin-top:8px">
      key ending <%= domain.hibp.apiKey.slice(-4) %>
      · last checked <%= domain.hibp.checkedAt ? new Date(domain.hibp.checkedAt).toISOString().slice(0, 16).replace("T", " ") : "not yet" %>
      <% if (domain.hibp.error) { %> · <span style="color:var(--tw-critical)">error: <%= domain.hibp.error %></span><% } %>
    </div>
    <form method="post" action="/domains/<%= domain._id %>/hibp/delete" style="margin:8px 0 0"><button class="tw-btn tw-btn-sm tw-btn-ghost" type="submit">Remove key</button></form>
  <% } else { %>
    <form method="post" action="/domains/<%= domain._id %>/hibp" style="margin:8px 0 0;display:flex;gap:6px;flex-wrap:wrap">
      <input class="tw-input tw-mono" name="apiKey" placeholder="your HIBP API key" required style="width:320px">
      <button class="tw-btn tw-btn-sm tw-btn-primary" type="submit">Save key</button>
    </form>
    <p class="tw-fg-2" style="font-size:11px;margin:8px 0 0">Verify <span class="tw-mono"><%= domain.name %></span> at haveibeenpwned.com/DomainSearch first; the free tier covers domains with up to 10 breached addresses.</p>
  <% } %>
  <p class="tw-fg-2" style="font-size:10px;margin:8px 0 0">Breach data by <a href="https://haveibeenpwned.com">Have I Been Pwned</a> (CC BY 4.0).</p>
</div>

<div class="dom-grid">
  <div class="tw-panel">
    <div class="dom-tabs" id="domTabs">
      <% ["new", "watched", "changed", "inactive", "ignored"].forEach(function (k, i) { %>
        <button class="dom-tab<%= i === 1 ? " active" : "" %>" data-tab-btn="<%= k %>" type="button"><%= k[0].toUpperCase() + k.slice(1) %><span class="count"><%= counts[k] %></span></button>
      <% }); %>
    </div>
    <% ["new", "watched", "changed", "inactive", "ignored"].forEach(function (k, i) { %>
      <div data-tab="<%= k %>" class="tw-panel-body" <%= i === 1 ? "" : "hidden" %>>
        <table class="tw-table-min">
          <thead><tr><th></th><th>Lookalike</th><th>Sim</th><th>A</th><th>MX</th><th>NS</th><th>Flags</th><th></th></tr></thead>
          <tbody>
          <% tabs[k].forEach(function (s) { %>
            <tr data-sighting="<%= s._id %>">
              <td class="tw-sev-cell"><span class="tw-sev tw-sev-<%= s.severity %>" title="<%= s.severity %>"></span></td>
              <td class="tw-mono"><%= s.lookalike %></td>
              <td class="tw-num"><%= typeof s.similarity === "number" ? s.similarity.toFixed(2) : "—" %></td>
              <td class="tw-mono tw-fg-2"><%= (s.dns && s.dns.a || []).join(", ") || "—" %></td>
              <td class="tw-mono tw-fg-2"><%= (s.dns && s.dns.mx || []).length ? "yes" : "—" %></td>
              <td class="tw-mono tw-fg-2"><%= (s.dns && s.dns.ns || [])[0] || "—" %></td>
              <td>
                <% if (s.punycode) { %><span class="chip chip-warn">IDN</span><% } %>
                <% if (s.substring) { %><span class="chip chip-info">substring</span><% } %>
                <% if (s.infra && s.infra.parked) { %><span class="chip">parked</span><% } %>
                <% if (s.infra && s.infra.cdn) { %><span class="chip">cdn</span><% } %>
                <% if (s.baseline) { %><span class="chip">baseline</span><% } %>
              </td>
              <td class="row-actions">
                <% if (s.state === "open") { %>
                  <button class="tw-btn tw-btn-sm tw-btn-ghost" data-act="dismiss">Dismiss</button>
                  <button class="tw-btn tw-btn-sm tw-btn-ghost" data-act="ignore">Ignore</button>
                <% } else { %>
                  <span class="chip"><%= s.state %></span>
                  <button class="tw-btn tw-btn-sm tw-btn-ghost" data-act="reopen">Reopen</button>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% if (tabs[k].length === 0) { %><tr><td colspan="8" class="tw-empty">Nothing here.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    <% }); %>
  </div>

  <div class="tw-panel">
    <div class="tw-panel-head"><div><div class="tw-eyebrow">Timeline</div><h2>Events</h2></div></div>
    <ul class="tl">
      <% events.forEach(function (e) { %>
        <li>
          <span class="tw-sev tw-sev-<%= e.severity %>" title="<%= e.severity %>"></span>
          <span class="tw-mono tw-fg-2"><%= new Date(e.at).toISOString().slice(0, 16).replace("T", " ") %></span>
          <span><span class="tw-mono"><%= e.kind %></span> <span class="tw-fg-2 tw-mono"><%= e.payload && e.payload.lookalike || "" %></span><% if (e.payload && e.payload.changed) { %> <span class="chip"><%= e.payload.changed.join(", ") %></span><% } %></span>
        </li>
      <% }); %>
      <% if (events.length === 0) { %><li class="tw-empty" style="display:block">No events yet.</li><% } %>
    </ul>
  </div>
</div>

<script>
document.getElementById("domTabs").addEventListener("click", function (e) {
  var b = e.target.closest("[data-tab-btn]");
  if (!b) return;
  document.querySelectorAll("[data-tab-btn]").forEach(function (x) { x.classList.toggle("active", x === b); });
  document.querySelectorAll("[data-tab]").forEach(function (p) { p.hidden = p.dataset.tab !== b.dataset.tabBtn; });
});
document.addEventListener("click", function (e) {
  var btn = e.target.closest("[data-act]");
  if (!btn) return;
  var row = btn.closest("[data-sighting]");
  TW.sightingAction("<%= domain._id %>", row.dataset.sighting, btn.dataset.act).then(function () { location.reload(); });
});
</script>
