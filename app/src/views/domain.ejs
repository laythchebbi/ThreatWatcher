<%
  var all = [].concat(tabs.new, tabs.changed, tabs.watched);
  var openSet = all.filter(function (s) { return s.state === "open"; });
  var urgent = openSet.filter(function (s) { return s.severity === "critical" || s.severity === "high"; }).sort(byWorst);
  var TAB_NAMES = { new: "New", changed: "Changed", watched: "Watched", inactive: "Inactive", ignored: "Ignored" };
  var EMPTY = {
    new: "No lookalike first seen in the last 7 days.",
    changed: "No lookalike changed its DNS in the last 7 days.",
    watched: "No older lookalikes under watch.",
    inactive: "No lookalike has stopped resolving.",
    ignored: "Nothing ignored."
  };
%>
<div class="tw-page-head">
  <div>
    <h1 class="tw-mono"><%= domain.name %></h1>
    <p class="tw-lede">
      <% if (!domain.lastWatchedAt) { %>
        The first watch has not run yet. It starts within a minute of adding the domain.
      <% } else if (urgent.length) { %>
        <strong><%= urgent.length %> lookalike<%= urgent.length === 1 ? "" : "s" %> rated high or critical</strong> <%= urgent.length === 1 ? "is" : "are" %> open. Worst: <span class="tw-mono"><%= urgent[0].lookalike %></span> (<%= urgent[0].severity %>).
      <% } else { %>
        <%= openSet.length %> open lookalike<%= openSet.length === 1 ? "" : "s" %>, none above medium.
      <% } %>
    </p>
    <p class="tw-meta" style="margin:6px 0 0">
      last watched <%= fmtTime(domain.lastWatchedAt) %> UTC · next <%= fmtTime(domain.nextWatchAt) %> UTC<% if (domain.watchingSince) { %> · <span style="color:var(--tw-info)">watching now</span><% } %>
    </p>
  </div>
  <form method="post" action="/domains/<%= domain._id %>/scan" style="margin:0"><button class="tw-btn tw-btn-primary" type="submit"<%- domain.watchingSince ? " disabled" : "" %>>Scan now</button></form>
</div>

<div class="tw-grid-main">
  <section class="tw-panel" aria-label="Lookalike domains">
    <div class="tw-tabs" role="tablist" aria-label="Lookalikes by status">
      <% tabOrder.forEach(function (k) { %>
        <button class="tw-tab" role="tab" type="button" id="tab-<%= k %>" aria-controls="panel-<%= k %>" aria-selected="<%= k === openTab %>" tabindex="<%= k === openTab ? 0 : -1 %>" data-tab-btn="<%= k %>"><%= TAB_NAMES[k] %><span class="count"><%= counts[k] %></span></button>
      <% }); %>
    </div>
    <% tabOrder.forEach(function (k) { %>
      <div data-tab="<%= k %>" class="tw-panel-body" role="tabpanel" id="panel-<%= k %>" aria-labelledby="tab-<%= k %>"<%- k === openTab ? "" : " hidden" %>>
        <table class="tw-table tw-table-stack">
          <thead><tr><th scope="col">Severity</th><th scope="col">Lookalike</th><th scope="col">Evidence</th><th scope="col" class="end"><span class="tw-fg-3">Actions</span></th></tr></thead>
          <tbody>
          <% tabs[k].forEach(function (s) { var dns = s.dns || {}, http = s.http || {}, rdap = s.rdap || {}, cert = s.cert || {}; %>
            <tr data-sighting="<%= s._id %>" data-name="<%= s.lookalike %>" data-sev="<%= s.severity %>">
              <td><span class="tw-sev" data-sev="<%= s.severity %>"><%= sevLabel(s.severity) %></span></td>
              <td>
                <span class="domain-name"><%= s.lookalike %></span>
                <% if (unicodeOf(s.lookalike)) { %><span class="tw-sub">shown as <span class="tw-mono"><%= unicodeOf(s.lookalike) %></span></span><% } %>
                <span class="tw-sub tw-mono">first seen <%= fmtDate(s.firstSeenAt) %></span>
                <span class="tw-chips" style="margin-top:4px">
                  <% if (s.punycode) { %><span class="tw-chip tw-chip-warn">IDN</span><% } %>
                  <% if (s.substring) { %><span class="tw-chip tw-chip-info">contains brand</span><% } %>
                  <% if (s.infra && s.infra.parked) { %><span class="tw-chip">parked</span><% } %>
                  <% if (s.infra && s.infra.cdn) { %><span class="tw-chip">CDN</span><% } %>
                  <% if (rdap.defensive) { %><span class="tw-chip">likely yours</span><% } %>
                  <% if (s.baseline) { %><span class="tw-chip">baseline</span><% } %>
                </span>
              </td>
              <td class="span">
                <ul class="tw-evidence">
                  <% if (dns.resolves) { %>
                    <li><span class="k">A</span> <%= (dns.a || [])[0] %><%= (dns.a || []).length > 1 ? " +" + (dns.a.length - 1) : "" %></li>
                    <% if ((dns.mx || []).length) { %><li><span class="k">MX</span> yes</li><% } %>
                  <% } else { %>
                    <li class="tw-fg-3">not resolving</li>
                  <% } %>
                  <% if (rdap.registrar) { %><li><span class="k">reg</span> <%= rdap.registrar %> <%= fmtDate(rdap.registeredAt) %></li><% } %>
                  <% if (cert.notBefore) { %><li><span class="k">cert</span> <%= cert.issuer || "" %> <%= fmtDate(cert.notBefore) %></li><% } %>
                  <% if (http.status) { %><li class="wrap"><span class="k">page</span> <%= http.status %><% if (http.hasPasswordForm) { %> <span class="alert">login form</span><% } %><% if (http.title) { %> “<%= http.title.slice(0, 48) %><%= http.title.length > 48 ? "…" : "" %>”<% } %></li><% } %>
                  <% if (typeof s.similarity === "number") { %><li><span class="k">similarity</span> <%= s.similarity.toFixed(2) %></li><% } %>
                </ul>
              </td>
              <td class="span">
                <div class="tw-row-actions">
                  <% if (s.state === "open") { %>
                    <button class="tw-btn tw-btn-sm tw-btn-ghost" type="button" data-act="dismiss" aria-label="Dismiss <%= s.lookalike %>">Dismiss</button>
                    <button class="tw-btn tw-btn-sm tw-btn-ghost" type="button" data-act="ignore" aria-label="Ignore <%= s.lookalike %>">Ignore</button>
                  <% } else { %>
                    <span class="tw-chip"><%= s.state %></span>
                    <button class="tw-btn tw-btn-sm tw-btn-ghost" type="button" data-act="reopen" aria-label="Reopen <%= s.lookalike %>">Reopen</button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
          <% if (tabs[k].length === 0) { %><tr class="tw-empty-row"><td colspan="4" class="tw-empty"><%= EMPTY[k] %></td></tr><% } %>
          </tbody>
        </table>
      </div>
    <% }); %>
  </section>

  <div class="tw-stack">
    <section class="tw-panel" aria-labelledby="posture-h">
      <div class="tw-panel-head"><h2 id="posture-h">Email posture</h2><span class="tw-meta">checked <%= fmtDate(domain.posture && domain.posture.checkedAt) %></span></div>
      <div class="tw-panel-section">
        <% if (domain.posture && domain.posture.grade) { var po = domain.posture; %>
          <div class="tw-grade" data-grade="<%= po.grade %>">
            <span class="letter" aria-label="Grade <%= po.grade %>"><%= po.grade %></span>
            <span class="tw-meta">
              SPF <%= po.spf && po.spf.present ? po.spf.policy : "missing" %> ·
              DMARC <%= po.dmarc && po.dmarc.present ? "p=" + po.dmarc.policy : "missing" %> ·
              DKIM <%= po.dkim && po.dkim.selectorsFound && po.dkim.selectorsFound.length ? po.dkim.selectorsFound.join(", ") : "not found" %>
            </span>
          </div>
          <% if (po.findings && po.findings.length) { %>
            <ul class="tw-findings"><% po.findings.forEach(function (f) { %><li><%= f %></li><% }); %></ul>
          <% } %>
        <% } else { %>
          <p class="tw-fg-2" style="margin:0">Checked on the first watch cycle.</p>
        <% } %>
      </div>
    </section>

    <section class="tw-panel" aria-labelledby="timeline-h">
      <div class="tw-panel-head"><h2 id="timeline-h">Timeline</h2><span class="tw-meta">times in UTC</span></div>
      <ul class="tw-list">
        <% events.forEach(function (e) { %>
          <li>
            <span class="line"><span class="tw-sev" data-sev="<%= e.severity %>"><%= sevLabel(e.severity) %></span><span><%= eventLabel(e.kind) %></span></span>
            <span class="line tw-meta"><span><%= fmtTime(e.at) %></span><span><%- include("partials/event-subject", { e: e }) %></span></span>
          </li>
        <% }); %>
        <% if (events.length === 0) { %><li class="tw-empty">No events yet.</li><% } %>
      </ul>
    </section>

    <section class="tw-panel" aria-labelledby="mentions-h">
      <div class="tw-panel-head"><h2 id="mentions-h">Leak mentions</h2><a class="tw-meta" href="/dark-web">all domains</a></div>
      <ul class="tw-list">
        <% mentions.forEach(function (m) { %>
          <li data-mention="<%= m._id %>">
            <span class="line"><span class="tw-sev" data-sev="<%= m.severity %>"><%= sevLabel(m.severity) %></span><span class="tw-chip"><%= m.source %></span><span class="tw-meta"><%= fmtDate(m.firstSeenAt) %></span></span>
            <span class="excerpt"><%= m.excerpt %></span>
            <span class="actions">
              <% if (m.state === "open") { %>
                <button class="tw-btn tw-btn-sm tw-btn-ghost" type="button" data-mact="dismiss" aria-label="Dismiss this <%= m.source %> mention">Dismiss</button>
              <% } else { %>
                <span class="tw-chip">dismissed</span><button class="tw-btn tw-btn-sm tw-btn-ghost" type="button" data-mact="reopen" aria-label="Reopen this <%= m.source %> mention">Reopen</button>
              <% } %>
            </span>
          </li>
        <% }); %>
        <% if (mentions.length === 0) { %><li class="tw-empty">No leak mentions.</li><% } %>
      </ul>
    </section>
  </div>
</div>

<details class="tw-panel" style="margin-top:16px"<%- domain.hibp && domain.hibp.error ? " open" : "" %>>
  <summary><h2>Watch settings</h2></summary>
  <div class="tw-panel-section">
    <h3 style="font-size:13px;margin-bottom:8px">Brand terms for leak matching</h3>
    <div class="tw-inline-form">
      <% (domain.terms || []).forEach(function (term) { %>
        <form method="post" action="/domains/<%= domain._id %>/terms/delete" class="tw-chip" style="display:inline-flex;align-items:center;gap:4px;margin:0;padding-right:2px">
          <span><%= term %></span><input type="hidden" name="term" value="<%= term %>"><button class="tw-btn tw-btn-sm tw-btn-ghost" style="height:20px;padding:0 5px" type="submit" aria-label="Remove term <%= term %>">×</button>
        </form>
      <% }); %>
    </div>
    <form method="post" action="/domains/<%= domain._id %>/terms" class="tw-inline-form" style="margin-top:10px">
      <label for="term-input" class="tw-fg-2" style="font-size:12px">Add a term</label>
      <input class="tw-input tw-mono" id="term-input" name="term" placeholder="e.g. acme bank" minlength="4" maxlength="40" required>
      <button class="tw-btn tw-btn-sm tw-btn-primary" type="submit">Add term</button>
    </form>
    <p class="tw-help">Your domain label is matched automatically. Add brand names people write without the domain, up to five.</p>
  </div>
  <div class="tw-panel-section">
    <h3 style="font-size:13px;margin-bottom:8px">Have I Been Pwned breaches</h3>
    <% if (domain.hibp && domain.hibp.apiKey) { %>
      <p class="tw-meta" style="margin:0">
        key ending <%= domain.hibp.apiKey.slice(-4) %> · last checked <%= fmtTime(domain.hibp.checkedAt) %> UTC
      </p>
      <% if (domain.hibp.error) { %><div class="tw-banner tw-banner-critical" style="margin:8px 0 0">The last breach check failed: <%= domain.hibp.error %>. Check the key, or remove it and add a new one.</div><% } %>
      <form method="post" action="/domains/<%= domain._id %>/hibp/delete" style="margin:8px 0 0"><button class="tw-btn tw-btn-sm tw-btn-ghost" type="submit">Remove key</button></form>
    <% } else { %>
      <form method="post" action="/domains/<%= domain._id %>/hibp" class="tw-inline-form">
        <label for="hibp-input" class="tw-fg-2" style="font-size:12px">API key</label>
        <input class="tw-input tw-mono" id="hibp-input" name="apiKey" type="password" autocomplete="off" spellcheck="false" required>
        <button class="tw-btn tw-btn-sm tw-btn-primary" type="submit">Save key</button>
      </form>
      <p class="tw-help">Verify <span class="tw-mono"><%= domain.name %></span> at haveibeenpwned.com/DomainSearch first. The free tier covers domains with up to 10 breached addresses.</p>
    <% } %>
    <p class="tw-help">Breach data by <a href="https://haveibeenpwned.com">Have I Been Pwned</a> (CC BY 4.0).</p>
  </div>
</details>

<script>
(function () {
  var tabs = Array.prototype.slice.call(document.querySelectorAll("[data-tab-btn]"));
  function select(b) {
    tabs.forEach(function (x) {
      var on = x === b;
      x.setAttribute("aria-selected", on);
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
    });
  }
  tabs.forEach(function (b, i) {
    b.addEventListener("click", function () { select(b); });
    b.addEventListener("keydown", function (e) {
      var j = e.key === "ArrowRight" ? i + 1 : e.key === "ArrowLeft" ? i - 1 : e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : null;
      if (j === null) return;
      e.preventDefault();
      var t = tabs[(j + tabs.length) % tabs.length];
      select(t);
      t.focus();
    });
  });

  // Row actions: busy state while saving, a visible message when saving fails, reload on success.
  function run(btn, call) {
    var holder = btn.closest(".tw-row-actions, .actions");
    var old = holder.querySelector(".tw-row-error");
    if (old) old.remove();
    btn.setAttribute("aria-busy", "true");
    btn.disabled = true;
    call().then(function () { location.reload(); }, function () {
      btn.removeAttribute("aria-busy");
      btn.disabled = false;
      var msg = document.createElement("span");
      msg.className = "tw-row-error";
      msg.setAttribute("role", "alert");
      msg.textContent = "Not saved. Try again.";
      holder.prepend(msg);
    });
  }
  document.addEventListener("click", function (e) {
    var btn = e.target.closest("[data-act]");
    if (btn) {
      var row = btn.closest("[data-sighting]");
      if (btn.dataset.act === "ignore" && (row.dataset.sev === "critical" || row.dataset.sev === "high") &&
          !confirm("Ignore " + row.dataset.name + "? It is rated " + row.dataset.sev + ", and ignored lookalikes raise no further events.")) return;
      run(btn, function () { return TW.sightingAction("<%= domain._id %>", row.dataset.sighting, btn.dataset.act); });
      return;
    }
    var mbtn = e.target.closest("[data-mact]");
    if (!mbtn) return;
    var mrow = mbtn.closest("[data-mention]");
    run(mbtn, function () { return TW.mentionAction("<%= domain._id %>", mrow.dataset.mention, mbtn.dataset.mact); });
  });
})();
</script>
