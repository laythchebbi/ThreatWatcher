<header class="tw-topbar">
  <nav class="tw-crumbs" aria-label="Breadcrumb">
    <% (typeof crumbs !== "undefined" ? crumbs : []).forEach(function (c, i, arr) { %>
      <% if (i === arr.length - 1) { %><span aria-current="page"><%= c %></span><% } else { %><span><%= c %></span><span class="sep" aria-hidden="true">/</span><% } %>
    <% }); %>
  </nav>
  <div class="tw-topbar-spacer"></div>
  <button class="tw-btn tw-btn-ghost" type="button" data-theme-toggle aria-label="Switch to light theme">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
  </button>
</header>
