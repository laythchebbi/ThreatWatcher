<% var p = e.payload || {}; %><% if (p.lookalike) { %><span class="tw-mono"><%= p.lookalike %></span><% } else if (e.kind === "leak_mention") { %><span class="tw-chip"><%= p.source %></span> <span class="tw-fg-2"><%= (p.matchedTerms || []).join(", ") %></span><% } else if (e.kind === "posture_weak") { %><span class="tw-fg-2">grade <%= p.grade %></span><% } %><% if (p.changed) { %> <span class="tw-fg-2">(<%= changedLabel(p.changed) %>)</span><% } %>
