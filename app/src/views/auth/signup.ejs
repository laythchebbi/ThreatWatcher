<%- include("_frame") %>
    <form method="post" action="/signup">
      <label class="tw-label" for="email">Email</label>
      <input class="tw-input tw-mono" id="email" name="email" type="email" autocomplete="email" required>
      <label class="tw-label" for="password">Password (10 or more characters)</label>
      <input class="tw-input" id="password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required>
      <button class="tw-btn tw-btn-primary tw-btn-lg" type="submit">Create account</button>
    </form>
    <div class="auth-links"><a href="/login">Already have an account? Sign in</a></div>
<%- include("_end") %>
