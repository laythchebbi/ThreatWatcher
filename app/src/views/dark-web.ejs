<div class="tw-page-head">
  <div>
    <h1>Leak mentions</h1>
    <p class="tw-lede">
      <% if (sourceCount === 0) { %>
        No dark-web sources are connected yet, so only Have I Been Pwned breaches can appear here. Add a breach key under Watch settings on a domain page.
      <% } else { %>
        Pages crawled from <%= sourceCount %> source<%= sourceCount === 1 ? "" : "s" %>, matched against each domain and its brand terms. Last crawl <span class="tw-mono"><%= lastCrawledAt ? fmtTime(lastCrawledAt) + " UTC" : "not yet" %></span>.
      <% } %>
    </p>
  </div>
</div>

<section class="tw-panel" aria-labelledby="open-h">
  <div class="tw-panel-head"><h2 id="open-h">Open mentions</h2><span class="tw-meta">newest first</span></div>
  <ul class="tw-list">
    <% mentions.forEach(function (m) { %>
      <li>
        <span class="line">
          <span class="tw-sev" data-sev="<%= m.severity %>"><%= sevLabel(m.severity) %></span>
          <a class="domain-name" href="/domains/<%= m.domainId %>"><%= m.domainName %></a>
          <span class="tw-chip"><%= m.source %></span>
          <span class="tw-meta"><%= fmtDate(m.firstSeenAt) %> · matched <%= (m.matchedTerms || []).join(", ") %></span>
        </span>
        <span class="excerpt"><%= m.excerpt %></span>
        <span class="tw-meta" style="font-size:11px"><%= m.sourceRef %></span>
      </li>
    <% }); %>
    <% if (mentions.length === 0) { %><li class="tw-empty">No open mentions. New matches appear here after each watch cycle.</li><% } %>
  </ul>
</section>

<section class="tw-panel" aria-labelledby="search-h">
  <div class="tw-panel-head"><h2 id="search-h">Search crawled pages</h2><span class="tw-meta">pages are kept 90 days</span></div>
  <div class="tw-panel-section">
    <form class="tw-inline-form" method="get" action="/dark-web" role="search">
      <label for="dw-q" class="tw-sr-only">Keyword, email or brand</label>
      <input class="tw-input tw-mono" id="dw-q" name="q" value="<%= q %>" placeholder="Keyword, email or brand" minlength="2" maxlength="200" autocomplete="off" style="max-width:none">
      <button class="tw-btn tw-btn-primary" type="submit">Search</button>
    </form>
  </div>
  <% if (results) { %>
    <ul class="tw-list" style="border-top:1px solid var(--tw-line)">
      <% results.forEach(function (p) { %>
        <li>
          <span class="line"><strong style="font-weight:500"><%= p.title || p.pageUrl %></strong><span class="tw-meta"><%= fmtDate(p.crawledAt) %></span></span>
          <span class="excerpt"><%= p.excerpt %></span>
          <span class="tw-meta" style="font-size:11px"><%= p.pageUrl %></span>
        </li>
      <% }); %>
      <% if (results.length === 0) { %><li class="tw-empty">No crawled page matches <span class="tw-mono"><%= q %></span>.</li><% } %>
    </ul>
  <% } %>
</section>
