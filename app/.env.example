# Required
MONGODB_URI=mongodb://127.0.0.1:27017/threatwatcher
# Public URL of this app (used for links in emails and the Origin check)
BASE_URL=http://localhost:3000
# Session cookie sealing — at least 32 random chars: openssl rand -base64 48
SESSION_PASSWORD=change-me-min-32-chars-of-random-bytes-aaaa

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SESSION_COOKIE_NAME=tw_session

# Python worker (dnstwist permutations + optional URL classifier)
PYTHON_BIN=python3
ML_URL_MODEL=ml/models/url_classifier.pkl

# Certificate transparency: free key from https://sslmate.com/certspotter (crt.sh is used without one)
# CERTSPOTTER_API_KEY=

# Watch
WATCH_INTERVAL_HOURS=6
WATCH_CONCURRENCY=3
MAX_DOMAINS_PER_ACCOUNT=5

# Behind nginx on the same host set TRUST_PROXY=loopback so rate limits see real client IPs.
TRUST_PROXY=false

# Optional: SMTP for alerts and sign-up mail (Plan 3). Unset = log instead of send.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# Optional: file target for pino
# LOG_FILE=/var/log/threat-watcher/app.log
