# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Backend connection
BACKEND_URL=http://localhost:3000
BACKEND_REQUEST_TIMEOUT_MS=10000

# Public URL of this app (used to build WorkOS redirect URIs)
FRONTEND_BASE_URL=http://localhost:4000

# WorkOS — copy from https://dashboard.workos.com
WORKOS_API_KEY=sk_test_change_me
WORKOS_CLIENT_ID=client_change_me
# Add this exact URL to your WorkOS project's Redirect URIs.
WORKOS_REDIRECT_URI=http://localhost:4000/auth/callback

# Session cookie sealing — must be at least 32 random chars.
# Generate with:  openssl rand -base64 48
SESSION_COOKIE_NAME=tw_session
SESSION_PASSWORD=change-me-min-32-chars-of-random-bytes-aaaa
SESSION_COOKIE_SECURE=false

# Optional file-target for pino
# LOG_FILE=/var/log/threat-watcher/frontend.log
