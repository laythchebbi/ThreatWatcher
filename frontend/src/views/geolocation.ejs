        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
          <span class="tw-mono" style="font-size:12px">cdn.northwind‑bank.com</span>
          <span class="tw-mono tw-num" style="font-size:11px;color:var(--tw-fg-1)">14</span>
        </div>
        <div style="height:3px;background:var(--tw-bg-3);border-radius:2px;overflow:hidden"><div style="width:10%;height:100%;background:var(--tw-info)"></div></div>
      </div>
    </div>
  </div>
</div>

<script>
  /* ──────────────────────────────────────────────────────────
     World map — generated procedurally as a dot stipple over
     hand-tuned land polygons. Equirectangular projection
     (lon −180..180 → x 0..1000, lat 90..−90 → y 0..520).
     ────────────────────────────────────────────────────────── */
  const land = [
    // North America
    "M150,90 L290,80 L320,120 L300,160 L260,200 L230,240 L210,260 L150,250 L120,210 L100,160 L130,110 Z",
    // Greenland
    "M310,70 L360,60 L370,100 L340,130 L310,120 Z",
    // Central America
    "M210,260 L260,255 L260,290 L230,300 L215,290 Z",
    // South America
    "M260,290 L320,290 L340,360 L320,440 L290,470 L260,460 L240,400 L240,330 Z",
    // Europe
    "M460,110 L560,100 L580,140 L560,170 L500,180 L470,160 L455,130 Z",
    // UK/Ireland
    "M440,120 L460,115 L460,150 L445,150 Z",
    // Scandinavia
    "M510,70 L560,75 L570,110 L530,115 L515,95 Z",
    // North Africa / Middle East
    "M470,180 L600,175 L640,220 L620,260 L560,275 L500,260 L475,225 Z",
    // Sub-Saharan Africa
    "M500,260 L620,260 L640,330 L600,400 L560,420 L520,400 L495,330 Z",
    // Russia / Siberia
    "M560,80 L820,70 L860,100 L830,140 L780,150 L700,140 L600,140 L575,110 Z",
    // Central Asia / India
    "M640,170 L760,170 L780,230 L740,265 L680,260 L640,225 Z",
    // SE Asia / China
    "M740,170 L840,170 L850,230 L800,255 L760,250 L745,210 Z",
    // Japan
    "M860,170 L880,165 L890,200 L870,210 L860,195 Z",
    // Indonesia
    "M780,290 L860,285 L880,310 L820,320 L790,315 Z",
    // Australia
    "M820,360 L920,350 L930,400 L880,425 L830,415 L815,385 Z",
    // NZ
    "M940,420 L960,415 L965,440 L945,445 Z",
    // Antarctica strip
    "M0,490 L1000,490 L1000,520 L0,520 Z",
  ];

  const worldLand = document.getElementById('worldLand');

  // Render BOTH dot version and polygon version. Variant CSS toggles which is shown.
  // Polygon (heat) version with hand-tuned activity weights.
  const heatWeights = [4,1,2,3,4,3,2,5,3,4,4,3,4,2,2,1,1];
  land.forEach((d, i) => {
    const p = document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('d', d);
    p.setAttribute('class','land');
    p.setAttribute('data-h', heatWeights[i] || 1);
    worldLand.appendChild(p);
  });

  // Dot stipple: generate a grid of points and only keep those inside any land polygon
  // (using SVGGeometryElement.isPointInFill in a hidden test path)
  const tester = document.createElementNS('http://www.w3.org/2000/svg','path');
  tester.setAttribute('d', land.filter((_,i) => i !== land.length-1).join(' '));
  worldLand.appendChild(tester);
  // Antarctica too thin — use full path including last
  const allTester = document.createElementNS('http://www.w3.org/2000/svg','path');
  allTester.setAttribute('d', land.join(' '));
  worldLand.appendChild(allTester);

  const dotsFrag = document.createDocumentFragment();
  const STEP = 7;
  const pt = document.getElementById('worldSvg').createSVGPoint();
  for (let y = 30; y < 500; y += STEP) {
    for (let x = 0; x < 1000; x += STEP) {
      pt.x = x; pt.y = y;
      // Only test against the combined polygon
      if (allTester.isPointInFill(pt)) {
        const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
        c.setAttribute('cx', x);
        c.setAttribute('cy', y);
        c.setAttribute('r', 1.1);
        c.setAttribute('class','dot');
        dotsFrag.appendChild(c);
      }
    }
  }
  worldLand.appendChild(dotsFrag);
  // remove testers from view
  tester.remove();
  allTester.style.display = 'none';
  allTester.setAttribute('fill','transparent');
  allTester.setAttribute('stroke','none');

  /* ──────────────────────────────────────────────────────────
     Arcs from origin → NYC target (24%, 42%)
     ────────────────────────────────────────────────────────── */
  const TGT = { x: 240, y: 218 }; // px in 1000×520
  const arcs = [
    { x: 600, y: 240, cls: 'crit' },
    { x: 730, y: 250, cls: 'crit' },
    { x: 540, y: 203, cls: 'warn' },
    { x: 780, y: 270, cls: 'info' },
    { x: 510, y: 240, cls: 'info' },
    { x: 880, y: 322, cls: 'warn' },
  ];
  const arcsLayer = document.getElementById('arcsLayer');
  arcs.forEach(a => {
    const dx = a.x - TGT.x, dy = a.y - TGT.y;
    const mx = (a.x + TGT.x) / 2;
    const my = (a.y + TGT.y) / 2 - Math.hypot(dx, dy) * 0.35;
    const p = document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('d', `M${TGT.x},${TGT.y} Q${mx},${my} ${a.x},${a.y}`);
    p.setAttribute('class', `geo-arc ${a.cls}`);
    arcsLayer.appendChild(p);
  });

  /* ──────────────────────────────────────────────────────────
     Side panel — events feed
     ────────────────────────────────────────────────────────── */
  const events = [
    { sev: 'crit', src: '185.220.101.42', country: 'RU', city: 'Moscow', desc: 'Credential‑stuffing burst against login.northwind‑bank.com — 4,820 attempts/min', meta: ['ASN AS49505', 'TOR exit', '14:31:51'] },
    { sev: 'crit', src: '103.146.23.118', country: 'CN', city: 'Beijing', desc: 'Automated scraping of customer portal pricing endpoints', meta: ['ASN AS4837', 'bot', '14:30:22'] },
    { sev: 'lookalike', src: 'northvvind‑bank.com', country: 'NL', city: 'Amsterdam', desc: 'New domain registered today — Cyrillic look‑alike with active MX records', meta: ['NameCheap', 'TLS issued 03h ago', '14:28:10'] },
    { sev: 'warn', src: '94.131.7.221', country: 'NL', city: 'Amsterdam', desc: 'Phishing kit fingerprint detected on hosted page', meta: ['ASN AS9009', '14:25:44'] },
    { sev: 'info',  src: 't.me/cardz_market', country: 'IR', city: 'Tehran', desc: 'Mention of "northwind" in a Telegram fraud channel — 2 new posts', meta: ['Telegram', '14:22:09'] },
    { sev: 'crit', src: '198.51.100.7', country: 'US', city: 'Ashburn', desc: 'SQL‑injection probes against /api/v2/accounts (412 unique payloads)', meta: ['ASN AS14061', '14:21:00'] },
    { sev: 'lookalike', src: 'n0rthwind-bank.com', country: 'IN', city: 'Mumbai', desc: 'Zero‑day registration with copied logo and login form', meta: ['NameSilo', '14:18:32'] },
    { sev: 'warn', src: '46.165.230.5', country: 'DE', city: 'Frankfurt', desc: 'Anomalous geo for staff SSO login — flagged for verification', meta: ['SAML', '14:15:11'] },
    { sev: 'info',  src: 'darkforums.cc', country: 'BR', city: 'São Paulo', desc: 'Thread referencing leaked employee email syntax', meta: ['Forum', '14:11:56'] },
    { sev: 'info',  src: 'breachforums.is', country: 'GB', city: 'London', desc: 'Post offering "fresh US bank logs" — keyword match', meta: ['Forum', '14:09:03'] },
    { sev: 'crit', src: '202.51.74.190', country: 'AU', city: 'Sydney', desc: 'WAF tripped 47×: known C2 callback pattern', meta: ['ASN AS9498', '14:06:48'] },
  ];

  const eventsList = events.map((e, i) => `
    <div class="geo-event" data-event-row="${i}">
      <div class="geo-event-mark ${e.sev}"></div>
      <div class="geo-event-body">
        <div class="src">${e.src}</div>
        <div class="desc">${e.desc}</div>
        <div class="meta"><span>${e.country} · ${e.city}</span>${e.meta.map(m => `<span>· ${m}</span>`).join('')}</div>
      </div>
      <div class="geo-event-time">${e.meta[e.meta.length-1].match(/\d/) ? e.meta[e.meta.length-1] : ''}</div>
    </div>
  `).join('');

  const countries = [
    { code:'RU', name:'Russia', count:64, sev:'crit', pct:100 },
    { code:'CN', name:'China', count:48, sev:'crit', pct:75 },
    { code:'US', name:'United States', count:42, sev:'warn', pct:65 },
    { code:'NL', name:'Netherlands', count:31, sev:'warn', pct:48 },
    { code:'IR', name:'Iran', count:24, sev:'crit', pct:38 },
    { code:'IN', name:'India', count:21, sev:'warn', pct:33 },
    { code:'DE', name:'Germany', count:18, sev:'info', pct:28 },
    { code:'BR', name:'Brazil', count:14, sev:'info', pct:22 },
    { code:'GB', name:'United Kingdom', count:12, sev:'info', pct:19 },
    { code:'KP', name:'North Korea', count:9,  sev:'crit', pct:14 },
    { code:'AU', name:'Australia', count:7,  sev:'warn', pct:11 },
    { code:'TR', name:'Turkey', count:6,  sev:'info', pct:9 },
  ];
  const countriesList = countries.map(c => `
    <div class="geo-country ${c.sev}">
      <div class="flag">${c.code}</div>
      <div class="name">${c.name}</div>
      <div class="bar"><div style="width:${c.pct}%"></div></div>
      <div class="count">${c.count}</div>
    </div>
  `).join('');

  function setTab(name) {
    document.querySelectorAll('#sideTabs button').forEach(b => b.classList.toggle('active', b.dataset.tab === name));
    document.getElementById('sidePanel').innerHTML = name === 'events' ? eventsList : countriesList;
    if (name === 'events') {
      document.querySelectorAll('[data-event-row]').forEach(r => {
        r.addEventListener('mouseenter', () => {
          const i = r.dataset.eventRow;
          document.querySelectorAll('.geo-pulse').forEach(p => p.style.transform = p.dataset.event === i ? 'translate(-50%,-50%) scale(1.6)' : 'translate(-50%,-50%)');
        });
        r.addEventListener('mouseleave', () => {
          document.querySelectorAll('.geo-pulse').forEach(p => p.style.transform = 'translate(-50%,-50%)');
        });
      });
    }
  }
  document.querySelectorAll('#sideTabs button').forEach(b => b.addEventListener('click', () => setTab(b.dataset.tab)));
  setTab('events');

  /* ── Variant toggle ── */
  document.querySelectorAll('[data-set-variant]').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-set-variant]').forEach(x => x.classList.toggle('active', x === b));
      document.getElementById('geoGrid').dataset.variant = b.dataset.setVariant;
    });
  });

  /* ── Trend bars ── */
  const trendBars = document.getElementById('trendBars');
  // 24 bars, each composed of 4 stacked segments
  const segs = [
    { color: 'var(--tw-info)', max: 8 },
    { color: 'oklch(0.78 0.14 75)', max: 4 },
    { color: 'var(--tw-warn)', max: 12 },
    { color: 'var(--tw-critical)', max: 6 },
  ];
  const heights = [
    [3,2,5,1],[2,1,4,1],[2,1,3,0],[1,1,4,1],[2,1,3,1],[1,0,2,0],
    [1,0,2,0],[2,1,3,1],[3,1,4,1],[4,2,6,2],[5,2,7,3],[6,2,8,3],
    [7,2,9,3],[6,3,8,3],[5,2,7,2],[4,2,6,2],[5,2,8,3],[6,3,9,4],
    [8,3,11,4],[7,3,10,5],[9,4,11,4],[8,3,10,4],[7,3,9,4],[6,4,11,5],
  ];
  const W = 480, H = 110, BW = (W - 24*2) / 24;
  heights.forEach((h, i) => {
    let y = H;
    h.forEach((v, k) => {
      const hh = v * 4;
      const r = document.createElementNS('http://www.w3.org/2000/svg','rect');
      r.setAttribute('x', i*(BW+2));
      r.setAttribute('y', y - hh);
      r.setAttribute('width', BW);
      r.setAttribute('height', Math.max(0,hh));
      r.setAttribute('fill', segs[k].color);
      r.setAttribute('opacity', i === 23 ? 1 : 0.85);
      trendBars.appendChild(r);
      y -= hh;
    });
  });
</script>
