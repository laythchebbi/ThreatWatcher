<style>
  /* ── Map area ─────────────────────────────────────────── */
  .geo-map-card {
    position: relative;
    background: var(--tw-bg-1);
    border: 1px solid var(--tw-line);
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 1000 / 520;
  }
  .geo-map-card svg.world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .geo-map-card .world .dot {
    fill: var(--tw-fg-3);
    opacity: 0.32;
  }
  [data-theme="light"] .geo-map-card .world .dot { opacity: 0.45; }
  .geo-map-card .world .grat {
    stroke: var(--tw-line);
    stroke-width: 0.5;
    fill: none;
    opacity: 0.5;
  }

  /* event pulse */
  .geo-pulse {
    position: absolute;
    width: 10px; height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    cursor: pointer;
  }
  .geo-pulse::before, .geo-pulse::after {
    content: "";
    position: absolute; inset: 0;
    border-radius: 50%;
  }
  .geo-pulse::before {
    background: currentColor;
    box-shadow: 0 0 12px currentColor;
  }
  .geo-pulse::after {
    background: currentColor;
    opacity: 0.4;
    animation: geo-ping 2.4s ease-out infinite;
  }
  @keyframes geo-ping {
    0%   { transform: scale(1);   opacity: 0.5; }
    80%  { transform: scale(3.6); opacity: 0;   }
    100% { transform: scale(3.6); opacity: 0;   }
  }
  .geo-pulse.crit  { color: var(--tw-critical); }
  .geo-pulse.warn  { color: var(--tw-warn); }
  .geo-pulse.info  { color: var(--tw-info); }
  .geo-pulse.safe  { color: var(--tw-safe); }
  .geo-pulse.lookalike { color: oklch(0.78 0.14 75); }

  /* arc */
  .geo-arc {
    fill: none;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 4 6;
    opacity: 0.6;
    animation: geo-arc-flow 8s linear infinite;
  }
  @keyframes geo-arc-flow {
    to { stroke-dashoffset: -200; }
  }
  .geo-arc.crit { stroke: var(--tw-critical); }
  .geo-arc.warn { stroke: var(--tw-warn); }
  .geo-arc.info { stroke: var(--tw-info); }

  .geo-target {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .geo-target::before {
    content: "";
    position: absolute; inset: -10px;
    border: 1.5px solid var(--tw-accent);
    border-radius: 50%;
    opacity: 0.7;
  }
  .geo-target::after {
    content: "";
    position: absolute;
    left: 50%; top: 50%;
    width: 6px; height: 6px;
    background: var(--tw-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 14px var(--tw-accent);
  }
  .geo-target-label {
    position: absolute;
    left: 14px; top: -8px;
    font-family: var(--tw-font-mono);
    font-size: 10px;
    color: var(--tw-fg-1);
    background: var(--tw-bg-1);
    border: 1px solid var(--tw-line);
    padding: 2px 6px;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* legend / overlay tools */
  .geo-overlay {
    position: absolute;
    background: color-mix(in srgb, var(--tw-bg-1) 92%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--tw-line);
    border-radius: 4px;
    font-family: var(--tw-font-mono);
    font-size: 10px;
    color: var(--tw-fg-1);
  }
  .geo-legend {
    bottom: 14px; left: 14px;
    padding: 10px 12px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .geo-legend .row {
    display: flex; align-items: center; gap: 8px;
  }
  .geo-legend .dot-key {
    width: 8px; height: 8px; border-radius: 50%;
    box-shadow: 0 0 8px currentColor;
  }
  .geo-time {
    top: 14px; right: 14px;
    padding: 6px 10px;
    display: flex; align-items: center; gap: 8px;
  }
  .geo-time .live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--tw-safe);
    box-shadow: 0 0 8px var(--tw-safe);
    animation: geo-blink 1.6s ease-in-out infinite;
  }
  @keyframes geo-blink { 50% { opacity: 0.3; } }
  .geo-stats {
    top: 14px; left: 14px;
    padding: 10px 14px;
    display: flex; gap: 22px;
  }
  .geo-stats .stat .v {
    font-family: var(--tw-font-mono);
    font-size: 18px;
    color: var(--tw-fg-0);
    line-height: 1;
  }
  .geo-stats .stat .l {
    font-family: var(--tw-font-mono);
    font-size: 9px;
    color: var(--tw-fg-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
  }

  /* ── Right side panel ─────────────────────────────────── */
  .geo-side {
    background: var(--tw-bg-1);
    border: 1px solid var(--tw-line);
    border-radius: 6px;
    overflow: hidden;
    display: flex; flex-direction: column;
  }
  .geo-side-tabs {
    display: flex;
    border-bottom: 1px solid var(--tw-line);
  }
  .geo-side-tabs button {
    flex: 1;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 12px 10px;
    font-family: var(--tw-font-mono);
    font-size: 11px;
    color: var(--tw-fg-2);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .geo-side-tabs button.active {
    color: var(--tw-fg-0);
    border-bottom-color: var(--tw-accent);
  }
  .geo-side-tabs button:hover:not(.active) { color: var(--tw-fg-1); }

  .geo-side-body {
    flex: 1;
    overflow-y: auto;
  }

  .geo-event {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 10px;
    align-items: start;
    padding: 12px 14px;
    border-bottom: 1px solid var(--tw-line);
    cursor: pointer;
  }
  .geo-event:hover { background: var(--tw-bg-2); }
  .geo-event.active { background: var(--tw-accent-soft); }

  .geo-event-mark {
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-top: 6px;
    box-shadow: 0 0 6px currentColor;
  }
  .geo-event-mark.crit { background: var(--tw-critical); color: var(--tw-critical); }
  .geo-event-mark.warn { background: var(--tw-warn); color: var(--tw-warn); }
  .geo-event-mark.info { background: var(--tw-info); color: var(--tw-info); }
  .geo-event-mark.lookalike { background: oklch(0.78 0.14 75); color: oklch(0.78 0.14 75); }

  .geo-event-body .src {
    font-family: var(--tw-font-mono);
    font-size: 12px;
    color: var(--tw-fg-0);
    margin-bottom: 2px;
  }
  .geo-event-body .desc {
    font-size: 12px;
    color: var(--tw-fg-1);
    line-height: 1.4;
  }
  .geo-event-body .meta {
    display: flex; gap: 10px;
    font-family: var(--tw-font-mono);
    font-size: 10px;
    color: var(--tw-fg-2);
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .geo-event-time {
    font-family: var(--tw-font-mono);
    font-size: 10px;
    color: var(--tw-fg-2);
    white-space: nowrap;
  }

  /* country list */
  .geo-country {
    display: grid;
    grid-template-columns: 26px 1fr 60px auto;
    gap: 10px;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid var(--tw-line);
    cursor: pointer;
  }
  .geo-country:hover { background: var(--tw-bg-2); }
  .geo-country .flag {
    width: 22px; height: 16px;
    background: var(--tw-bg-3);
    border: 1px solid var(--tw-line);
    border-radius: 2px;
    font-family: var(--tw-font-mono);
    font-size: 9px;
    color: var(--tw-fg-1);
    display: grid; place-items: center;
  }
  .geo-country .name {
    font-size: 12px;
    color: var(--tw-fg-0);
  }
  .geo-country .count {
    font-family: var(--tw-font-mono);
    font-size: 12px;
    color: var(--tw-fg-1);
    text-align: right;
  }
  .geo-country .bar {
    width: 60px;
    height: 4px;
    background: var(--tw-bg-3);
    border-radius: 2px;
    overflow: hidden;
  }
  .geo-country .bar > div {
    height: 100%;
    background: var(--tw-critical);
    border-radius: 2px;
  }
  .geo-country.warn .bar > div { background: var(--tw-warn); }
  .geo-country.info .bar > div { background: var(--tw-info); }

  /* ── Layout ───────────────────────────────────────────── */
  .geo-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 16px;
    margin-bottom: 16px;
  }
  .geo-bottom {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 16px;
  }

  /* ── Variant: choropleth heat ──────────────────────────── */
  [data-variant="heat"] .geo-map-card .world .dot { display: none; }
  [data-variant="heat"] .geo-map-card .world .land {
    fill: var(--tw-bg-2);
    stroke: var(--tw-line);
    stroke-width: 0.5;
  }
  [data-variant="heat"] .geo-map-card .world .land[data-h="1"] { fill: oklch(0.32 0.03 240); }
  [data-variant="heat"] .geo-map-card .world .land[data-h="2"] { fill: oklch(0.42 0.08 60); }
  [data-variant="heat"] .geo-map-card .world .land[data-h="3"] { fill: oklch(0.55 0.14 50); }
  [data-variant="heat"] .geo-map-card .world .land[data-h="4"] { fill: oklch(0.62 0.18 30); }
  [data-variant="heat"] .geo-map-card .world .land[data-h="5"] { fill: oklch(0.66 0.20 25); }

  [data-variant="dots"] .geo-map-card .world .land { display: none; }

  /* variant toggle */
  .geo-variant-toggle {
    display: inline-flex;
    border: 1px solid var(--tw-line);
    border-radius: 4px;
    overflow: hidden;
    background: var(--tw-bg-1);
  }
  .geo-variant-toggle button {
    background: transparent;
    border: 0;
    padding: 6px 12px;
    font-family: var(--tw-font-mono);
    font-size: 11px;
    color: var(--tw-fg-2);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .geo-variant-toggle button.active {
    background: var(--tw-bg-2);
    color: var(--tw-fg-0);
  }
</style>

