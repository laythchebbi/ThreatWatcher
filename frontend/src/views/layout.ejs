<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/styles.css">
<%- style %>
</head>
<body>
<div class="tw-shell">
  <%- include('partials/sidebar') %>
  <main class="tw-main">
    <%- include('partials/topbar') %>
    <div class="tw-page">
      <% if (typeof demoMode !== 'undefined' && demoMode) { %>
        <div style="margin-bottom:14px;padding:8px 14px;border:1px solid var(--tw-warn);background:var(--tw-warn-soft);color:var(--tw-warn);border-radius:var(--tw-radius);font-family:var(--tw-font-mono);font-size:12px">
          ⚠ DEMO MODE — authentication is bypassed and data is in-memory. For local evaluation only.
        </div>
      <% } %>
      <div id="tw-page-content">
        <%- body %>
      </div>
    </div>
  </main>
</div>
<script src="/static/js/app.js"></script>
<%- script %>
</body>
</html>
