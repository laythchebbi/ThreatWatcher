<style>
.ds-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:14px; }
.swatch { background:var(--tw-bg-1); border:1px solid var(--tw-line); border-radius:var(--tw-radius); overflow:hidden; }
.swatch .chip { height:60px; }
.swatch .meta { padding:10px 12px; font-family:var(--tw-font-mono); font-size:11px; }
.swatch .meta b { color:var(--tw-fg-0); }
.swatch .meta div { color:var(--tw-fg-2); }
.ds-section { margin-bottom:32px; }
.ds-row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; padding:14px 0; }
.ds-token { display:inline-flex; gap:8px; align-items:center; padding:8px 12px; background:var(--tw-bg-1); border:1px solid var(--tw-line); border-radius:var(--tw-radius); font-family:var(--tw-font-mono); font-size:12px; }
</style>

<div class="tw-page-head" style="margin-bottom:18px">
  <div class="tw-eyebrow">Account · Design system</div>
  <h1>Threat Watcher design language</h1>
  <p class="tw-fg-2" style="margin:6px 0 0">Reference palette, typography, and components for engineering and design alignment.</p>
</div>

<section class="ds-section">
  <h2 style="margin-bottom:8px">Palette</h2>
  <div class="ds-grid">
    <% [
      ["--tw-bg-0", "page bg"], ["--tw-bg-1", "card"], ["--tw-bg-2", "raised"], ["--tw-bg-3", "input"],
      ["--tw-line", "hairline"], ["--tw-line-strong", "border"],
      ["--tw-fg-0", "fg primary"], ["--tw-fg-1", "fg secondary"], ["--tw-fg-2", "fg tertiary"], ["--tw-fg-3", "fg disabled"],
      ["--tw-accent", "accent"], ["--tw-critical", "critical"], ["--tw-warn", "warn"], ["--tw-safe", "safe"], ["--tw-info", "info"]
    ].forEach(function (s) { %>
      <div class="swatch">
        <div class="chip" style="background:var(<%= s[0] %>)"></div>
        <div class="meta"><b><%= s[1] %></b><div><%= s[0] %></div></div>
      </div>
    <% }); %>
  </div>
</section>

<section class="ds-section">
  <h2 style="margin-bottom:8px">Typography</h2>
  <div class="tw-fg-1" style="line-height:1.8">
    <div style="font-size:32px;font-weight:500;letter-spacing:-0.02em">Aa — IBM Plex Sans</div>
    <div class="tw-mono" style="font-size:32px;font-weight:500">Aa — IBM Plex Mono</div>
    <div class="tw-eyebrow">EYEBROW · MONO · 11px · 0.08em</div>
    <h1>Heading 1 — 22 / 28</h1>
    <h2>Heading 2 — 18 / 24</h2>
    <h3>Heading 3 — 15 / 22</h3>
    <p>Body — 14 / 20. The default body type is Plex Sans with letter-spacing -0.005em.</p>
    <p class="tw-mono">Mono — 13 / 20. Used for domains, IDs, hashes, and key/value pairs.</p>
  </div>
</section>

<section class="ds-section">
  <h2 style="margin-bottom:8px">Buttons</h2>
  <div class="ds-row">
    <button class="tw-btn tw-btn-primary">Primary</button>
    <button class="tw-btn tw-btn-ghost">Ghost</button>
    <button class="tw-btn tw-btn-primary tw-btn-sm">Small</button>
    <button class="tw-btn tw-btn-primary tw-btn-lg">Large</button>
    <button class="tw-btn tw-btn-primary" disabled>Disabled</button>
  </div>
</section>

<section class="ds-section">
  <h2 style="margin-bottom:8px">Chips &amp; pills</h2>
  <div class="ds-row">
    <span class="tw-chip">neutral</span>
    <span class="tw-chip tw-chip-safe">safe</span>
    <span class="tw-chip tw-chip-warn">warn</span>
    <span class="tw-chip tw-chip-crit">critical</span>
    <span class="tw-chip tw-chip-info">info</span>
  </div>
</section>

<section class="ds-section">
  <h2 style="margin-bottom:8px">Form controls</h2>
  <div class="ds-row" style="flex-direction:column; align-items:flex-start; max-width:380px">
    <label class="tw-label">Standard input</label>
    <input class="tw-input" placeholder="standard input">
    <label class="tw-label">Monospace</label>
    <input class="tw-input tw-mono" placeholder="example.com">
    <label class="tw-label">Large</label>
    <input class="tw-input tw-input-lg" placeholder="large">
  </div>
</section>

<section class="ds-section">
  <h2 style="margin-bottom:8px">Tokens</h2>
  <div class="ds-row">
    <span class="ds-token">--tw-radius : 6px</span>
    <span class="ds-token">--tw-radius-lg : 10px</span>
    <span class="ds-token">--tw-row : 36px</span>
    <span class="ds-token">--tw-pad : 14px</span>
  </div>
</section>
