<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/styles.css">
<style>
  .login-card {
    width: 100%;
    max-width: 380px;
    padding: 32px;
    background: var(--tw-bg-1);
    border: 1px solid var(--tw-line);
    border-radius: var(--tw-radius-lg);
  }
  .login-brand {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 24px;
  }
  .login-brand .name { font-weight: 500; font-size: 16px; }
  .login-brand .sub  { font-family: var(--tw-font-mono); font-size: 10px; color: var(--tw-fg-2); }
  .login-error {
    background: var(--tw-critical-soft);
    color: var(--tw-critical);
    border: 1px solid var(--tw-critical);
    border-radius: var(--tw-radius);
    padding: 10px 12px;
    font-size: 12px;
    margin-bottom: 14px;
  }
  .login-cta { display: flex; flex-direction: column; gap: 10px; }
  .login-cta .or {
    display:flex; align-items:center; gap:10px;
    color: var(--tw-fg-3); font-family: var(--tw-font-mono); font-size:10px;
    text-transform: uppercase; letter-spacing: 0.08em;
    margin: 6px 0;
  }
  .login-cta .or::before, .login-cta .or::after {
    content:""; flex:1; height:1px; background: var(--tw-line);
  }
  .login-help { margin-top: 18px; font-size: 12px; color: var(--tw-fg-2); text-align: center; }
  .login-help a { color: var(--tw-accent); }
  .oauth-btn {
    display:flex; align-items:center; justify-content:center; gap:10px;
    width: 100%;
    background: var(--tw-bg-2);
    color: var(--tw-fg-0);
    border: 1px solid var(--tw-line-strong);
    border-radius: var(--tw-radius);
    padding: 0 14px;
    height: 40px;
    font-size: 13px;
    text-decoration: none;
    transition: background .15s;
  }
  .oauth-btn:hover { background: var(--tw-bg-3); }
  .oauth-btn svg { width: 16px; height: 16px; }
</style>
</head>
<body>
<div class="tw-frame-center">
  <div class="login-card">
    <div class="login-brand">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
        <path d="M13 2 3 5v8c0 5.5 4.2 9.5 10 11 5.8-1.5 10-5.5 10-11V5l-10-3Z" fill="var(--tw-accent-soft)" stroke="var(--tw-accent)" stroke-width="1.4"/>
        <circle cx="13" cy="12" r="3" fill="var(--tw-accent)"/>
      </svg>
      <div>
        <div class="name">Threat Watcher</div>
        <div class="sub">SIGN IN</div>
      </div>
    </div>
    <% if (error) { %>
      <div class="login-error"><%= error %></div>
    <% } %>
    <div class="login-cta">
      <a class="tw-btn tw-btn-primary tw-btn-lg" href="/auth/sign-in?next=<%= encodeURIComponent(next) %>" style="justify-content:center">
        Continue with email
      </a>
      <div class="or">or</div>
      <a class="oauth-btn" href="/auth/sign-in/google">
        <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 11.1H12v3.8h5.35c-.23 1.36-1.6 4-5.35 4-3.22 0-5.86-2.66-5.86-5.95s2.64-5.94 5.86-5.94c1.83 0 3.06.78 3.76 1.45l2.56-2.47C16.83 4.55 14.65 3.5 12 3.5 6.93 3.5 2.85 7.6 2.85 12.7s4.08 9.2 9.15 9.2c5.28 0 8.78-3.7 8.78-8.92 0-.6-.07-1.07-.13-1.88Z"/></svg>
        Continue with Google
      </a>
      <a class="oauth-btn" href="/auth/sign-in/microsoft">
        <svg viewBox="0 0 24 24"><path fill="#F25022" d="M3 3h8.5v8.5H3z"/><path fill="#7FBA00" d="M12.5 3H21v8.5h-8.5z"/><path fill="#00A4EF" d="M3 12.5h8.5V21H3z"/><path fill="#FFB900" d="M12.5 12.5H21V21h-8.5z"/></svg>
        Continue with Microsoft
      </a>
    </div>
    <div class="login-help">
      Need access? Ask your admin to send an invite.
    </div>
  </div>
</div>
</body>
</html>
