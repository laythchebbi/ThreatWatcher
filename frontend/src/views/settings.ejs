<style>
.settings-grid { display:grid; grid-template-columns:200px 1fr; gap:24px; }
@media (max-width:900px) { .settings-grid { grid-template-columns:1fr; } }
.settings-nav { display:flex; flex-direction:column; gap:2px; position: sticky; top: 14px; }
.settings-nav a {
  padding:8px 12px; border-radius:var(--tw-radius); color:var(--tw-fg-1); text-decoration:none; font-size:13px;
}
.settings-nav a.active { background:var(--tw-bg-2); color:var(--tw-fg-0); }
.settings-section { background:var(--tw-bg-1); border:1px solid var(--tw-line); border-radius:var(--tw-radius-lg); padding:20px; margin-bottom:14px; }
.settings-section h2 { margin:0 0 6px; }
.settings-section .desc { color:var(--tw-fg-2); margin-bottom:14px; font-size:13px; }
.field { display:grid; gap:6px; margin-bottom:12px; }
.tag-input { display:flex; flex-wrap:wrap; gap:6px; padding:8px; background:var(--tw-bg-2); border:1px solid var(--tw-line); border-radius:var(--tw-radius); min-height:42px; }
.tag-input .tag { display:inline-flex; align-items:center; gap:6px; padding:4px 8px; background:var(--tw-bg-3); border-radius:99px; font-family:var(--tw-font-mono); font-size:11px; }
.tag-input .tag button { background:none; border:0; color:var(--tw-fg-2); cursor:pointer; font-size:14px; }
.tag-input input { flex:1; min-width:120px; background:transparent; border:0; outline:0; color:var(--tw-fg-0); font-family:var(--tw-font-mono); font-size:13px; }
.kv { font-family:var(--tw-font-mono); font-size:12px; color:var(--tw-fg-1); margin: 4px 0; }
.kv span { color:var(--tw-fg-2); margin-right:6px; }
.invite-row { display:grid; grid-template-columns: 1fr 130px 110px 100px; gap:8px; padding:10px 0; border-bottom:1px solid var(--tw-line); align-items:center; font-size: 13px; }
.invite-row:last-child { border-bottom: 0; }
.invite-email { font-family: var(--tw-font-mono); }
.invite-status { font-family: var(--tw-font-mono); font-size: 10px; padding: 2px 8px; border-radius:99px; }
.invite-status.pending { background: var(--tw-warn-soft); color: var(--tw-warn); }
.invite-status.accepted { background: var(--tw-safe-soft); color: var(--tw-safe); }
.invite-status.revoked, .invite-status.expired { background: var(--tw-bg-3); color: var(--tw-fg-2); }
</style>

<div class="tw-page-head" style="margin-bottom:18px">
  <div class="tw-eyebrow">Account · Settings</div>
  <h1>Workspace settings</h1>
</div>

<div class="settings-grid">
  <nav class="settings-nav">
    <a href="#profile" class="active">Profile</a>
    <a href="#security">Security</a>
    <a href="#monitored">Monitored domains</a>
    <% if (isAdmin) { %>
      <a href="#team">Team &amp; invitations</a>
    <% } %>
    <a href="#integrations">Integrations</a>
    <a href="#danger">Danger zone</a>
  </nav>

  <div>
    <section id="profile" class="settings-section">
      <h2>Profile</h2>
      <div class="desc">Identity managed by WorkOS. App-specific fields stored locally.</div>
      <form id="profileForm">
        <div class="field">
          <label class="tw-label">Email</label>
          <input class="tw-input tw-mono" value="<%= profile && profile.email || '' %>" disabled>
        </div>
        <div class="field">
          <label class="tw-label" for="displayName">Display name</label>
          <input class="tw-input" id="displayName" name="displayName" value="<%= profile && profile.displayName || '' %>">
        </div>
        <div class="field">
          <label class="tw-label">Role</label>
          <input class="tw-input tw-mono" value="<%= profile && profile.role || 'analyst' %>" disabled>
        </div>
        <button class="tw-btn tw-btn-primary" type="submit">Save profile</button>
        <span id="profileStatus" class="tw-fg-2" style="margin-left:10px;font-size:12px"></span>
      </form>
    </section>

    <section id="security" class="settings-section">
      <h2>Security</h2>
      <div class="desc">Password and two-factor authentication are managed by WorkOS AuthKit.</div>
      <div class="kv"><span>Authenticated as</span><%= (workos && workos.email) || (profile && profile.email) || "—" %></div>
      <div class="kv"><span>WorkOS user ID</span><%= (workos && workos.sub) || "—" %></div>
      <div class="kv"><span>Organization</span><%= (workos && workos.organizationId) || "—" %></div>
      <div class="kv"><span>Role</span><%= (workos && workos.role) || (profile && profile.role) || "analyst" %></div>
      <div style="display:flex; gap:8px; margin-top:14px; flex-wrap: wrap">
        <a class="tw-btn tw-btn-primary" href="/auth/sign-in?next=%2Fsettings%23security">Set up / re-enroll 2FA</a>
        <form method="post" action="/auth/sign-out" style="margin:0">
          <button class="tw-btn tw-btn-ghost" type="submit">Sign out everywhere</button>
        </form>
      </div>
      <p class="tw-fg-2" style="font-size:12px;margin-top:14px">
        Clicking <b>Set up 2FA</b> re-authenticates you through WorkOS — if your project has MFA enabled (the default in M1), AuthKit will prompt you to enroll a TOTP authenticator (Authenticator, 1Password, Bitwarden). Recovery codes are issued on enrollment — store them safely.
      </p>
    </section>

    <section id="monitored" class="settings-section">
      <h2>Monitored domains</h2>
      <div class="desc">Domains scanned automatically on the daily cron run and surfaced on the dashboard.</div>
      <form id="monitoredForm">
        <div class="tag-input" id="tagInput">
          <% (profile && profile.monitoredDomains || []).forEach(function (d) { %>
            <span class="tag" data-value="<%= d %>"><%= d %><button type="button" aria-label="Remove">×</button></span>
          <% }); %>
          <input id="newTag" placeholder="add domain, press Enter">
        </div>
        <button class="tw-btn tw-btn-primary" type="submit" style="margin-top:14px">Save list</button>
        <span id="monitoredStatus" class="tw-fg-2" style="margin-left:10px;font-size:12px"></span>
      </form>
    </section>

    <% if (isAdmin) { %>
    <section id="team" class="settings-section">
      <h2>Team &amp; invitations</h2>
      <div class="desc">Admins invite new users by email. Invitations are sent through WorkOS — the recipient picks email/password or OAuth on the hosted page.</div>
      <form id="inviteForm" style="display:grid; grid-template-columns: 1fr 140px auto; gap:8px; margin-bottom:14px">
        <input class="tw-input tw-mono" id="inviteEmail" name="email" type="email" placeholder="new.user@example.com" required>
        <select class="tw-input" id="inviteRole" name="role">
          <option value="analyst">analyst</option>
          <option value="admin">admin</option>
        </select>
        <button class="tw-btn tw-btn-primary" type="submit">Send invite</button>
      </form>
      <div id="inviteStatus" class="tw-fg-2" style="font-size:12px;margin-bottom:14px"></div>

      <h3 style="margin:18px 0 6px">Pending invitations</h3>
      <div id="inviteList" class="tw-mono" style="font-size:12px;color:var(--tw-fg-2)">Loading…</div>
    </section>
    <% } %>

    <section id="integrations" class="settings-section">
      <h2>Integrations</h2>
      <div class="desc">Configured on the backend via <code class="tw-mono">.env</code> — see <code class="tw-mono">SECURITY.md</code>.</div>
      <div class="kv"><span>WorkOS</span><%= (workos && workos.sub) ? "connected" : "not connected" %></div>
      <div class="kv"><span>Tor proxy</span>backend/scripts/darkweb_crawl.py uses socks5h://127.0.0.1:9050</div>
    </section>

    <section id="danger" class="settings-section" style="border-color:var(--tw-critical);">
      <h2 style="color:var(--tw-critical)">Danger zone</h2>
      <div class="desc">These actions are irreversible.</div>
      <form method="post" action="/auth/sign-out"><button class="tw-btn tw-btn-ghost" type="submit">Sign out</button></form>
    </section>
  </div>
</div>

<script>
// ── Tag input ─────────────────────────────────────────────────────────────
(function () {
  var input = document.getElementById("newTag");
  var holder = document.getElementById("tagInput");
  function addTag(v) {
    v = (v || "").trim().toLowerCase();
    if (!v || !/^[a-z0-9.-]+\.[a-z]{2,}$/.test(v)) return;
    if (holder.querySelector('[data-value="' + v + '"]')) return;
    var t = document.createElement("span");
    t.className = "tag";
    t.setAttribute("data-value", v);
    t.innerHTML = v + '<button type="button" aria-label="Remove">×</button>';
    holder.insertBefore(t, input);
  }
  input.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === ",") {
      e.preventDefault();
      addTag(input.value);
      input.value = "";
    }
  });
  holder.addEventListener("click", function (e) {
    if (e.target.tagName === "BUTTON") e.target.parentElement.remove();
  });
})();

// ── Profile save ──────────────────────────────────────────────────────────
document.getElementById("profileForm").addEventListener("submit", async function (e) {
  e.preventDefault();
  var status = document.getElementById("profileStatus");
  status.textContent = "saving…";
  try {
    var displayName = document.getElementById("displayName").value;
    var res = await fetch("/api/me", { method:"PATCH", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ displayName }) });
    status.textContent = res.ok ? "saved" : "failed";
  } catch { status.textContent = "failed"; }
});

// ── Monitored domains save ────────────────────────────────────────────────
document.getElementById("monitoredForm").addEventListener("submit", async function (e) {
  e.preventDefault();
  var status = document.getElementById("monitoredStatus");
  status.textContent = "saving…";
  var tags = Array.from(document.querySelectorAll('#tagInput .tag')).map(function (n) { return n.dataset.value; });
  try {
    var res = await fetch("/api/me/monitored", { method:"PUT", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ monitoredDomains: tags }) });
    status.textContent = res.ok ? "saved" : "failed";
  } catch { status.textContent = "failed"; }
});

// ── Invitations (admin) ───────────────────────────────────────────────────
<% if (isAdmin) { %>
async function loadInvitations() {
  var el = document.getElementById("inviteList");
  el.textContent = "Loading…";
  try {
    var res = await fetch("/api/admin/invitations", { credentials:"same-origin" });
    if (!res.ok) throw new Error("status " + res.status);
    var data = await res.json();
    var invs = data.invitations || [];
    if (!invs.length) { el.textContent = "No pending invitations."; return; }
    el.innerHTML = invs.map(function (inv) {
      var state = (inv.state || "pending").toLowerCase();
      return '<div class="invite-row">'
        + '<div class="invite-email">' + (inv.email || "—") + '</div>'
        + '<div>' + (inv.role || inv.roleSlug || "—") + '</div>'
        + '<div><span class="invite-status ' + state + '">' + state + '</span></div>'
        + '<div style="text-align:right">'
        +   '<button class="tw-btn tw-btn-sm tw-btn-ghost" data-revoke="' + inv.id + '">Revoke</button>'
        + '</div>'
        + '</div>';
    }).join("");
    el.querySelectorAll("[data-revoke]").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        if (!confirm("Revoke invitation?")) return;
        await fetch("/api/admin/invitations/" + btn.dataset.revoke, { method:"DELETE", credentials:"same-origin" });
        loadInvitations();
      });
    });
  } catch (err) {
    el.textContent = "Could not load invitations.";
  }
}

document.getElementById("inviteForm").addEventListener("submit", async function (e) {
  e.preventDefault();
  var status = document.getElementById("inviteStatus");
  status.textContent = "sending…";
  var body = {
    email: document.getElementById("inviteEmail").value,
    role: document.getElementById("inviteRole").value,
  };
  try {
    var res = await fetch("/api/admin/invitations", {
      method:"POST", credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify(body),
    });
    if (res.ok) {
      status.textContent = "invitation sent ✓";
      document.getElementById("inviteEmail").value = "";
      loadInvitations();
    } else {
      var err = await res.json().catch(function () { return {}; });
      status.textContent = "failed: " + (err.error || res.status);
    }
  } catch (err) { status.textContent = "failed"; }
});

loadInvitations();
<% } %>
</script>
