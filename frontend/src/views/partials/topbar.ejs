<header class="tw-topbar">
  <nav class="tw-crumbs">
    <% (crumbs || []).forEach(function (c, i, arr) { %>
      <% if (i === arr.length - 1) { %>
        <span class="cur"><%= c %></span>
      <% } else { %>
        <span><%= c %></span><span class="sep">/</span>
      <% } %>
    <% }); %>
  </nav>
  <div class="tw-topbar-spacer"></div>
  <div class="tw-input-icon" style="width:280px">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input class="tw-input tw-mono" placeholder="Search domains, scans, hashes…">
  </div>
  <button class="tw-btn tw-btn-ghost" title="Quick scan" onclick="location.href='/new-scan'">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"/></svg>
    <span>Scan</span>
    <span class="kbd">⌘K</span>
  </button>
  <button class="tw-btn tw-btn-ghost" title="Toggle theme" onclick="TW.toggleTheme()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
  </button>
</header>
