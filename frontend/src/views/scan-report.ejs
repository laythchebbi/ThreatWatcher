<style>
.report-head { display:grid; grid-template-columns:auto 1fr auto; gap:24px; align-items:center; margin-bottom:18px; }
.score-gauge { position:relative; width:140px; height:140px; }
.score-gauge svg { width:100%; height:100%; transform:rotate(-90deg); }
.score-gauge .ring-bg { stroke:var(--tw-line-strong); fill:none; stroke-width:8; }
.score-gauge .ring-fg { stroke:var(--tw-accent); fill:none; stroke-width:8; stroke-linecap:round; transition:stroke-dashoffset .8s ease; }
.score-gauge .label { position:absolute; inset:0; display:grid; place-items:center; flex-direction:column; }
.score-gauge .value { font-size:32px; font-weight:500; font-variant-numeric:tabular-nums; }
.score-gauge .caption { font-family:var(--tw-font-mono); font-size:10px; color:var(--tw-fg-2); letter-spacing:0.08em; text-transform:uppercase; }

.report-tabs { display:flex; gap:0; border-bottom:1px solid var(--tw-line); margin-bottom:14px; }
.report-tab { padding:10px 16px; cursor:pointer; color:var(--tw-fg-2); border-bottom:2px solid transparent; user-select:none; }
.report-tab.active { color:var(--tw-fg-0); border-bottom-color:var(--tw-accent); }
.report-tab .count { margin-left:6px; padding:1px 6px; background:var(--tw-bg-3); color:var(--tw-fg-1); border-radius:99px; font-family:var(--tw-font-mono); font-size:10px; }

.findings-table { width:100%; border-collapse:collapse; font-size:13px; }
.findings-table th, .findings-table td { padding:11px 14px; text-align:left; }
.findings-table thead th { color:var(--tw-fg-2); font-family:var(--tw-font-mono); font-size:10px; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; border-bottom:1px solid var(--tw-line); }
.findings-table tbody tr { border-bottom:1px solid var(--tw-line); }
.findings-table tbody tr:last-child { border-bottom:0; }
.findings-table tbody tr:hover { background:var(--tw-bg-2); }
.findings-table .chip { display:inline-block; padding:2px 8px; border-radius:99px; font-family:var(--tw-font-mono); font-size:10px; margin-right:4px; }
.chip-warn { background:var(--tw-warn-soft); color:var(--tw-warn); }
.chip-crit { background:var(--tw-critical-soft); color:var(--tw-critical); }
.chip-safe { background:var(--tw-safe-soft); color:var(--tw-safe); }
.chip-info { background:var(--tw-info-soft); color:var(--tw-info); }
.chip-muted { background:var(--tw-bg-3); color:var(--tw-fg-2); }
</style>

<div class="report-head">
  <div class="score-gauge">
    <svg viewBox="0 0 120 120">
      <circle class="ring-bg" cx="60" cy="60" r="52"/>
      <circle class="ring-fg" cx="60" cy="60" r="52"
        stroke-dasharray="327"
        stroke-dashoffset="<%= (327 * (1 - Math.min(1, Math.max(0, report.secureScore || 0)))).toFixed(2) %>"
        style="stroke: var(--tw-<%= (report.secureScore || 0) >= 0.7 ? 'safe' : ((report.secureScore || 0) >= 0.4 ? 'warn' : 'critical') %>)"/>
    </svg>
    <div class="label">
      <div class="value tw-num"><%= (report.secureScore != null ? report.secureScore.toFixed(2) : "—") %></div>
      <div class="caption">SecureScore</div>
    </div>
  </div>
  <div>
    <div class="tw-eyebrow">Scan report · <%= new Date(report.createdAt).toUTCString() %></div>
    <h1 class="tw-mono"><%= report.domain %></h1>
    <div class="tw-fg-2" style="margin-top:4px">
      Confidence <span class="tw-mono"><%= ((report.confidence || 0) * 100).toFixed(0) %>%</span>
      · ID <span class="tw-mono"><%= report._id %></span>
    </div>
  </div>
  <div style="display:flex; gap:8px; align-items:flex-start">
    <button class="tw-btn tw-btn-ghost" id="copyJsonBtn">Copy JSON</button>
    <a class="tw-btn tw-btn-primary" href="/new-scan?domain=<%= encodeURIComponent(report.domain) %>">Re-scan</a>
  </div>
</div>

<div class="report-tabs" id="reportTabs">
  <div class="report-tab active" data-tab="lookalikes">Lookalikes <span class="count"><%= (report.findings && report.findings.lookalikes) || 0 %></span></div>
  <div class="report-tab" data-tab="urls">Malicious URLs <span class="count"><%= (report.findings && report.findings.maliciousUrls) || 0 %></span></div>
  <div class="report-tab" data-tab="content">Content matches <span class="count"><%= (report.findings && report.findings.contentMatches) || 0 %></span></div>
  <div class="report-tab" data-tab="darkweb">Dark web <span class="count"><%= (report.findings && report.findings.darkWebHits) || 0 %></span></div>
  <div class="report-tab" data-tab="leaks">Data leaks <span class="count"><%= (report.findings && report.findings.dataLeaks) || 0 %></span></div>
</div>

<div class="tw-panel">
  <div data-pane="lookalikes" class="report-pane">
    <table class="findings-table">
      <thead><tr><th>Lookalike domain</th><th>Similarity</th><th>Evidence</th><th>Action</th></tr></thead>
      <tbody>
        <% const scored = (report.reportContent && report.reportContent.scored) || []; %>
        <% scored.forEach(function (s) { %>
          <tr>
            <td class="tw-mono"><%= s.domain %></td>
            <td class="tw-num"><%= (s.similarity || 0).toFixed(2) %></td>
            <td>
              <% if (s.punycode) { %><span class="chip chip-warn">IDN</span><% } %>
              <% if (s.substring) { %><span class="chip chip-info">substring</span><% } %>
              <% if (s.mlLabel === 1) { %><span class="chip chip-crit">ML: malicious</span><% } else if (s.mlLabel === 0) { %><span class="chip chip-safe">ML: safe</span><% } else { %><span class="chip chip-muted">ML: —</span><% } %>
            </td>
            <td>
              <button class="tw-btn tw-btn-sm tw-btn-ghost">False positive</button>
            </td>
          </tr>
        <% }); %>
        <% if (scored.length === 0) { %>
          <tr><td colspan="4" style="text-align:center;color:var(--tw-fg-3);padding:36px">No lookalike domains detected.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div data-pane="urls" class="report-pane" hidden>
    <div style="padding:36px;text-align:center;color:var(--tw-fg-3)">URL ML scoring runs inline during scan — empty here means no candidates exceeded the threshold.</div>
  </div>
  <div data-pane="content" class="report-pane" hidden>
    <div style="padding:36px;text-align:center;color:var(--tw-fg-3)">No phishing-content matches.</div>
  </div>
  <div data-pane="darkweb" class="report-pane" hidden>
    <div style="padding:36px;text-align:center;color:var(--tw-fg-3)">No dark-web mentions.</div>
  </div>
  <div data-pane="leaks" class="report-pane" hidden>
    <div style="padding:36px;text-align:center;color:var(--tw-fg-3)">No data-leak references.</div>
  </div>
</div>

<script>
document.getElementById("reportTabs").addEventListener("click", function (e) {
  var t = e.target.closest(".report-tab");
  if (!t) return;
  document.querySelectorAll(".report-tab").forEach(function (n) { n.classList.toggle("active", n === t); });
  var name = t.dataset.tab;
  document.querySelectorAll(".report-pane").forEach(function (p) { p.hidden = p.dataset.pane !== name; });
});
document.getElementById("copyJsonBtn").addEventListener("click", function () {
  var data = <%- JSON.stringify(report).replace(/</g, "\\u003c") %>;
  navigator.clipboard.writeText(JSON.stringify(data, null, 2));
});
</script>
